{
	"targets": {
		"clock": {
			"width": 1,
			"height": 1,
			"persistent": true,
			"clear_color": 0
		},
		"clock_next": {
			"width": 1,
			"height": 1
		}
	},
	"passes": [
		{
			"vertex_shader": "minecraft:core/screenquad",
			"fragment_shader": "mgs:post/clock",
			"inputs": [
				{"sampler_name": "Clock","target": "clock"}
			],
			"output": "clock_next"
		},
		{
			"vertex_shader": "minecraft:core/screenquad",
			"fragment_shader": "mgs:post/copy",
			"inputs": [
				{"sampler_name": "In","target": "clock_next"}
			],
			"output": "clock"
		},
		{
			"vertex_shader": "minecraft:core/screenquad",
			"fragment_shader": "mgs:post/flash",
			"inputs": [
				{"sampler_name": "Clock","target": "clock_next"},
				{"sampler_name": "In","target": "minecraft:main"},
				{"sampler_name": "Depth","target": "minecraft:main","use_depth_buffer": true},
				{"sampler_name": "Spark","location": "mgs:flash","width": 1536,"height": 1536,"bilinear": true}
			],
			"output": "minecraft:main",
			"uniforms": {
				"FlashConfig": [{"name": "Color","type": "vec4","value": [0.6,0.0,1.0,1.0]},{"name": "Spark","type": "vec4","value": [0.0,-0.125,0.6,0.6]},{"name": "Duration","type": "float","value": 0.8}]
			}
		}
	]
}
