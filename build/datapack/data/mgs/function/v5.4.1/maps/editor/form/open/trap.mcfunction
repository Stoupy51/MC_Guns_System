function mgs:v5.4.1/maps/editor/form/target
data modify storage mgs:temp dialog set value {"type": "minecraft:multi_action", "title": {"translate": "mgs.trap","fallback": "Trap", "color": "red", "bold": true}, "body": [{"type": "minecraft:plain_message", "width": 400, "contents": ["", {"translate": "mgs.hover_a_name_for_its_help","fallback": "Hover a name for its help:", "color": "gray"}, "\n", [{"text":"ⓘ ", "color": "aqua", "hover_event": {"action": "show_text", "value": [{"text": "Trap behaviour:\n0 = Fire: lethal to zombies, burns players inside\n1 = Electric: lethal to zombies, shocks players inside\n2 = Turret: auto-fires at the nearest zombie every 5 ticks", "color": "gray"}]}}, {"translate": "mgs.type","fallback": "Type"}], "   ", [{"text":"ⓘ ", "color": "aqua", "hover_event": {"action": "show_text", "value": [{"text": "How long the trap stays active, in ticks (20 ticks = 1 second).", "color": "gray"}]}}, {"translate": "mgs.duration","fallback": "Duration"}], "   ", [{"text":"ⓘ ", "color": "aqua", "hover_event": {"action": "show_text", "value": [{"text": "Cooldown before the trap can be re-triggered, in ticks (20 = 1s).", "color": "gray"}]}}, {"translate": "mgs.cooldown","fallback": "Cooldown"}], "   ", [{"text":"ⓘ ", "color": "aqua", "hover_event": {"action": "show_text", "value": [{"text": "true", "color": "green"}, {"text": ": works only once the map's\npower is switched on.\n", "color": "gray"}, {"text": "false", "color": "green"}, {"text": ": always works.", "color": "gray"}]}}, {"translate": "mgs.power","fallback": "Power"}]]}], "inputs": [{"type": "minecraft:single_option", "key": "type", "label": "Type", "width": 300, "options": [{"id": "0", "display": "Fire"}, {"id": "1", "display": "Electric"}, {"id": "2", "display": "Turret"}]}, {"type": "minecraft:text", "key": "price", "label": {"translate": "mgs.price","fallback": "Price", "hover_event": {"action": "show_text", "value": [{"translate": "mgs.cost_in_points_to_buy_use_this_element","fallback": "Cost in points to buy/use this element.", "color": "gray"}]}}, "initial": "", "max_length": 64, "width": 200}, {"type": "minecraft:text", "key": "duration", "label": {"translate": "mgs.duration_in_ticks","fallback": "Duration, in ticks", "hover_event": {"action": "show_text", "value": [{"translate": "mgs.how_long_the_trap_stays_active_in_ticks_20_ticks_1_second","fallback": "How long the trap stays active, in ticks (20 ticks = 1 second).", "color": "gray"}]}}, "initial": "", "max_length": 64, "width": 200}, {"type": "minecraft:text", "key": "cooldown", "label": {"translate": "mgs.cooldown_in_ticks","fallback": "Cooldown, in ticks", "hover_event": {"action": "show_text", "value": [{"translate": "mgs.cooldown_before_the_trap_can_be_re_triggered_in_ticks_20_1s","fallback": "Cooldown before the trap can be re-triggered, in ticks (20 = 1s).", "color": "gray"}]}}, "initial": "", "max_length": 64, "width": 200}, {"type": "minecraft:boolean", "key": "power", "label": "Only once the power is on", "initial": true, "on_true": "1", "on_false": "0"}, {"type": "minecraft:text", "key": "effect_radius", "label": "Effect radius: x, y, z", "initial": "", "max_length": 64, "width": 300}, {"type": "minecraft:text", "key": "offset_pos", "label": "Effect centre from the trap: x, y, z", "initial": "", "max_length": 64, "width": 300}], "actions": [{"label": {"translate": "mgs.save","fallback": "Save", "color": "green"}, "action": {"type": "dynamic/run_command", "template": "/function mgs:v5.4.1/maps/editor/form/trap_apply {type:$(type),price:$(price),duration:$(duration),cooldown:$(cooldown),power:$(power),effect_radius:\"$(effect_radius)\",offset_pos:\"$(offset_pos)\"}"}}], "exit_action": {"label": {"translate": "mgs.cancel","fallback": "Cancel", "color": "gray"}}}
execute if data entity @s data{type:0} run data modify storage mgs:temp dialog.inputs[0].options[0].initial set value 1b
execute if data entity @s data{type:1} run data modify storage mgs:temp dialog.inputs[0].options[1].initial set value 1b
execute if data entity @s data{type:2} run data modify storage mgs:temp dialog.inputs[0].options[2].initial set value 1b
data modify storage mgs:temp dialog.inputs[1].initial set string entity @s data.price
data modify storage mgs:temp dialog.inputs[2].initial set string entity @s data.duration
data modify storage mgs:temp dialog.inputs[3].initial set string entity @s data.cooldown
data modify storage mgs:temp dialog.inputs[4].initial set from entity @s data.power

# The lists without their brackets.
function mgs:v5.4.1/maps/editor/form/open/trap_texts with entity @s data
execute as @a[tag=mgs.ed_form_user] run function mgs:v5.4.1/multiplayer/show_dialog with storage mgs:temp

