data modify storage mgs:temp dialog.body[0].contents[4].text set from entity @s data.magazine_id
execute if data entity @s data{magazine_id:""} run data modify storage mgs:temp dialog.body[0].contents[4].text set value "no ammo"
data modify storage mgs:temp dialog.inputs[0].initial set from entity @s data.title
data modify storage mgs:temp dialog.inputs[1].initial set string entity @s data.price
data modify storage mgs:temp dialog.inputs[2].initial set string entity @s data.refill_price
data modify storage mgs:temp dialog.inputs[3].initial set string entity @s data.refill_price_pap
execute as @a[tag=mgs.ed_form_user] run function mgs:v5.3.0/multiplayer/show_dialog with storage mgs:temp

