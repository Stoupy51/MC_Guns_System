execute unless entity @n[type=minecraft:marker,tag=mgs.ed_form_target] run return run tellraw @s [[{"text":"","color":"gold"},"[",{"translate":"mgs","fallback":"MGS"},"] "],{"translate":"mgs.the_element_being_edited_is_gone","fallback":"The element being edited is gone.","color":"red"}]
$data modify storage mgs:temp _form set value {title:"$(name)",price:$(price),refill_price:$(refill_price),refill_price_pap:$(refill_price_pap)}
$data modify storage mgs:temp _form_pick set value {weapon:"$(weapon)",own:"$(own_magazine)",magazine:"$(magazine)"}
execute unless data storage mgs:temp _form_pick{weapon:""} run data modify storage mgs:temp _form.weapon_id set from storage mgs:temp _form_pick.weapon
execute unless data storage mgs:temp _form_pick{weapon:""} if data storage mgs:temp _form_pick{magazine:"auto"} run data modify storage mgs:temp _form.magazine_id set from storage mgs:temp _form_pick.own
execute if data storage mgs:temp _form_pick{magazine:"none"} run data modify storage mgs:temp _form.magazine_id set value ""
execute unless data storage mgs:temp _form_pick{magazine:"auto"} unless data storage mgs:temp _form_pick{magazine:"none"} run data modify storage mgs:temp _form.magazine_id set from storage mgs:temp _form_pick.magazine
execute as @n[type=minecraft:marker,tag=mgs.ed_form_target] run data modify entity @s data merge from storage mgs:temp _form
tellraw @s [[{"text":"","color":"gold"},"[",{"translate":"mgs","fallback":"MGS"},"] "],{"translate":"mgs.wallbuy_saved","fallback":"Wallbuy saved: ","color":"green"},{"entity":"@n[type=minecraft:marker,tag=mgs.ed_form_target]","nbt":"data.weapon_id","color":"yellow"},[{"text":" ","color":"green"}, {"translate":"mgs.with","fallback":"with "}],{"entity":"@n[type=minecraft:marker,tag=mgs.ed_form_target]","nbt":"data.magazine_id","color":"yellow"}]

