		"translate": "mgs.instant_kill","fallback": "Instant Kill",
		"color": "gold",
		"bold": true
	},
	"body": [
		{"type": "minecraft:plain_message","contents": {"translate": "mgs.one_shot_kills_for_a_duration_self_only","fallback": "One-shot kills for a duration (self only)","color": "gray"}}
	],
	"actions": [
		{"label": {"translate": "mgs.off","fallback": "OFF","color": "red"},"tooltip": {"translate": "mgs.set_instant_kill_off","fallback": "Set instant kill off"},"action": {"type": "run_command","command": "/scoreboard players set @s mgs.special.instant_kill 0"}},
		{"label": {"text": "10s","color": "yellow"},"tooltip": {"translate": "mgs.set_instant_kill_for_10s","fallback": "Set instant kill for 10s"},"action": {"type": "run_command","command": "/scoreboard players set @s mgs.special.instant_kill 200"}},
		{"label": {"text": "30s","color": "yellow"},"tooltip": {"translate": "mgs.set_instant_kill_for_30s","fallback": "Set instant kill for 30s"},"action": {"type": "run_command","command": "/scoreboard players set @s mgs.special.instant_kill 600"}},
		{"label": {"text": "60s","color": "yellow"},"tooltip": {"translate": "mgs.set_instant_kill_for_60s","fallback": "Set instant kill for 60s"},"action": {"type": "run_command","command": "/scoreboard players set @s mgs.special.instant_kill 1200"}},
		{"label": {"text": "∞","color": "light_purple"},"tooltip": [{"translate": "mgs.set_instant_kill_for","fallback": "Set instant kill for"}, " ∞"],"action": {"type": "run_command","command": "/scoreboard players set @s mgs.special.instant_kill 72000"}}
